// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "git": {
    "diff_base": "default_branch"
  },
  "soft_wrap": "editor_width",
  "diff_view_style": "unified",
  "project_panel": {
    "hide_hidden": false,
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "session": {
    "restore_unsaved_buffers": false,
  },
  "window_decorations": "server",
  "restore_on_startup": "launchpad",
  "edit_predictions": {
    "ollama": {
      "prompt_format": "qwen",
      "model": "nishtahir/zeta:latest",
    },
    "provider": "ollama",
  },
  "git_panel": {
    "group_by": "status",
    "tree_view": true,
    "dock": "left",
    "sort_by_path": false,
  },
  "colorize_brackets": true,
  "show_signature_help_after_edits": true,
  "disable_ai": true,
  "icon_theme": {
    "mode": "system",
    "dark": "Catppuccin Macchiato",
    "light": "Catppuccin Latte",
  },
  "outline_panel": {
    "dock": "left",
  },
  "show_edit_predictions": true,
  "vim_mode": false,
  "ui_font_size": 16,
  "buffer_font_size": 14,
  "theme": {
    "mode": "system",
    "light": "Catppuccin Latte (sapphire)",
    "dark": "Catppuccin Macchiato (sapphire)",
  },
  "terminal": {
    "font_family": "FiraCode Nerd Font",
    "font_size": 11.25,
  },
  "calls": {
    "mute_on_join": true,
  },
  "tabs": {
    "file_icons": true,
    "git_status": true,
    "show_diagnostics": "errors",
  },
  "lsp": {
    "discord_presence": {
      "initialization_options": {
        "idle": {
          "action": "clear_activity",
        },
      },
    },
    "biome": {
      "settings": {
        "require_config_file": true,
      },
    },
    "tinymist": {
      "settings": {
        "exportPdf": "onSave",
        "outputPath": "$root/$name",
      },
    },
  },
  "inlay_hints": {
    "enabled": true,
  },
  "file_scan_exclusions": [
     "**/.svn",
     "**/.hg",
     "**/.jj",
     "**/CVS",
     "**/.DS_Store",
     "**/Thumbs.db",
     "**/.classpath",
     "**/.settings"
   ],
}
