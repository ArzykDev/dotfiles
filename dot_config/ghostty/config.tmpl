font-family = JuliaMono Nerd Font
font-size = {{ if eq .chezmoi.os "darwin" }}14{{ else }}12{{ end }}

cursor-style = block

theme = eldritch.conf

window-save-state = never
window-width = 120
window-height = 40

window-padding-x = 4
window-padding-y = 4
window-padding-balance = true

macos-titlebar-style = transparent

keybind = shift+enter=text:\n
keybind = cmd+shift+t=new_tab
keybind = ctrl+shift+insert=new_tab
keybind = ctrl+shift+arrow_left=previous_tab
keybind = ctrl+shift+arrow_right=next_tab

cursor-click-to-move = false

shell-integration-features = ssh-env

config-file = ?local.conf
