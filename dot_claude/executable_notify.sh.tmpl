#!/usr/bin/env bash
# Claude Code sound cue: plays a distinct sound per Notification event so each
# one is recognizable by ear. The desktop banner itself comes from Claude Code's
# native notifications (preferredNotifChannel=auto); this script only adds audio.
# Ghostty's own notification sound is muted in macOS System Settings so the
# native banner stays silent and we never double up. Wire one Notification-hook
# matcher per event to `notify.sh <matcher>`.
set -eu

event="${1:-}"

{{ if eq .chezmoi.os "darwin" -}}
case "$event" in
  permission_prompt) sound=/System/Library/Sounds/Tink.aiff ;;
  idle_prompt)       sound=/System/Library/Sounds/Glass.aiff ;;
  agent_completed)   sound=/System/Library/Sounds/Hero.aiff ;;
  agent_needs_input) sound=/System/Library/Sounds/Morse.aiff ;;
  *) exit 0 ;;
esac
afplay "$sound"
{{ else -}}
base=/usr/share/sounds/ocean/stereo
case "$event" in
  permission_prompt) sound="$base/message-new-instant.oga" ;;
  idle_prompt)       sound="$base/completion-success.oga" ;;
  agent_completed)   sound="$base/dialog-information.oga" ;;
  agent_needs_input) sound="$base/message-attention.oga" ;;
  *) exit 0 ;;
esac
command -v paplay >/dev/null 2>&1 && [ -f "$sound" ] && paplay "$sound"
{{ end -}}
