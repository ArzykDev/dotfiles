#!/bin/bash
{{ if eq .chezmoi.os "darwin" -}}
brew bundle --file=/dev/stdin <<EOF
{{ range .packages.darwin.brews -}}
brew {{ . | quote }}
{{ end -}}
EOF
{{ else if eq .chezmoi.os "linux" -}}
if command -v dnf >/dev/null; then
  sudo dnf install -y {{ range .packages.linux.dnf }}{{ . | quote }} {{ end }}
elif command -v apt-get >/dev/null; then
  sudo apt-get update
  sudo apt-get install -y {{ range .packages.linux.apt }}{{ . | quote }} {{ end }}
fi
{{ end -}}
command -v cargo-binstall >/dev/null || cargo install --locked cargo-binstall
cargo binstall -y --locked {{ range .packages.shared.cargo }}{{ . | quote }} {{ end }}
